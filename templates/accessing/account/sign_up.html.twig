{% extends 'base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Sign up{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">Create account</h1>
                    <p class="text-secondary">Create a new account to start the Accessing lifecycle.</p>

                    {{ form_start(form, { action: path('accessing_sign_up') }) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.plainPassword) }}
                        {{ form_row(form.displayName) }}
                        {{ form_row(form.phoneNumber) }}
                        <div class="d-flex justify-content-between align-items-center">
                            {{ form_widget(form.submit, { attr: { class: 'btn btn-primary' } }) }}
                            <a href="{{ path('accessing_sign_in') }}">Back to sign in</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
