{% extends 'base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Recover access{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">Recover account</h1>
                    <p class="text-secondary">Request a password recovery code for an existing account.</p>

                    {{ form_start(form, { action: path('accessing_recover') }) }}
                        {{ form_row(form.emailAddress) }}
                        <div class="d-flex justify-content-between align-items-center">
                            <button class="btn btn-primary" type="submit">Continue</button>
                            <a href="{{ path('accessing_sign_in') }}">Back to sign in</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
