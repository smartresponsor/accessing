{% extends '@Accessing/access/base.html.twig' %}

{% set accessPage = 'access-signin' %}
{% set accessTitle = 'Sign in' %}
{% set accessSubtitle = 'Use your access credentials to continue.' %}

{% block access_body %}
  <div class="interfacing-access-stack">
    <div>

      <h1>Sign in to continue</h1>
      <p class="interfacing-muted">This Accessing page owns the credential form surface. The actual credential check remains in the Accessing/security component.</p>
    </div>

    {{ form_start(form, { action: path('access.signin_submit'), attr: form.vars.attr|merge({ 'data-access-submit-surface': 'signin' }) }) }}
      <div class="interfacing-form-row">
        {{ form_label(form.emailAddress) }}
        {{ form_widget(form.emailAddress, { attr: form.emailAddress.vars.attr|merge({ class: 'interfacing-input' }) }) }}
        {{ form_errors(form.emailAddress) }}
      </div>
      <div class="interfacing-form-row">
        {{ form_label(form.plainPassword) }}
        <span class="interfacing-password-control">
          {{ form_widget(form.plainPassword, { attr: form.plainPassword.vars.attr|merge({ class: 'interfacing-input' }) }) }}
          <button type="button" class="interfacing-password-toggle" data-access-password-toggle aria-label="Show password" aria-pressed="false">
            <svg class="interfacing-password-eye interfacing-password-eye--closed" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3l18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 5.2A10.8 10.8 0 0 1 12 5c5.2 0 9.3 4.4 10.5 6.1a1.5 1.5 0 0 1 0 1.8 14.8 14.8 0 0 1-3 3.2M6.1 6.2A15.7 15.7 0 0 0 1.5 11a1.5 1.5 0 0 0 0 1.8C2.7 14.6 6.8 19 12 19a10.6 10.6 0 0 0 3.1-.5"/></svg>
            <svg class="interfacing-password-eye interfacing-password-eye--open" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M1.5 12s3.8-7 10.5-7 10.5 7 10.5 7-3.8 7-10.5 7S1.5 12 1.5 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </span>
        {{ form_errors(form.plainPassword) }}
      </div>
      <button class="interfacing-button interfacing-button-primary interfacing-button--full" type="submit" data-access-submit data-access-submitting-label="Signing in…">
        <span class="interfacing-submit-spinner" aria-hidden="true"></span>
        <span data-access-submit-label>Sign in</span>
      </button>
      {{ form_rest(form) }}
    {{ form_end(form) }}
    <a class="interfacing-button-secondary interfacing-button--full" href="{{ path('access.google_start') }}">Continue with Google</a>

    <div class="interfacing-inline-row">
      <span></span>
      <a href="{{ path('access.recover_request') }}">Forgot password?</a>
    </div>

    <button class="interfacing-button-secondary" type="button" data-access-passkey-signin>Sign in with a passkey</button>
    <p class="interfacing-muted" data-access-passkey-status hidden></p>

    <p class="interfacing-muted">New here? <a href="{{ path('access.register') }}">Create access</a>.</p>
  </div>

  <script>
    (() => {
      document.addEventListener('click', event => {
        const toggle = event.target.closest('[data-access-password-toggle]');
        if (!toggle) return;

        const wrapper = toggle.closest('.interfacing-password-control');
        const password = wrapper?.querySelector('input');
        if (!password) return;

        const visible = password.type === 'text';
        password.type = visible ? 'password' : 'text';
        toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
        toggle.setAttribute('aria-pressed', visible ? 'false' : 'true');
        wrapper.classList.toggle('is-password-visible', !visible);
      });
    })();
  </script>

  <script>
    (() => {
      const button = document.querySelector('[data-access-passkey-signin]');
      const status = document.querySelector('[data-access-passkey-status]');
      if (!button || !window.PublicKeyCredential || !navigator.credentials) return;

      const decode = (value) => {
        const normalized = value.replace(/-/g, '+').replace(/_/g, '/');
        const binary = atob(normalized + '='.repeat((4 - normalized.length % 4) % 4));
        return Uint8Array.from(binary, character => character.charCodeAt(0)).buffer;
      };
      const encode = (value) => {
        const bytes = new Uint8Array(value);
        let binary = '';
        bytes.forEach(byte => binary += String.fromCharCode(byte));
        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
      };

      button.addEventListener('click', async () => {
        if ('127.0.0.1' === window.location.hostname) {
          const localUrl = new URL(window.location.href);
          localUrl.hostname = 'localhost';
          window.location.assign(localUrl.toString());
          return;
        }

        button.disabled = true;
        status.hidden = false;
        status.textContent = 'Waiting for your passkey…';
        try {
          const optionsResponse = await fetch('{{ path('access.passkey_authentication_options') }}', {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });
          const optionsPayload = await optionsResponse.json();
          if (!optionsResponse.ok || !optionsPayload.publicKey) {
            throw new Error(optionsPayload.message || optionsPayload.error || 'Passkey options could not be loaded.');
          }
          const publicKey = optionsPayload.publicKey;
          const challenge = publicKey.challenge;
          publicKey.challenge = decode(challenge);
          if (Array.isArray(publicKey.allowCredentials)) {
            publicKey.allowCredentials = publicKey.allowCredentials.map(item => ({ ...item, id: decode(item.id) }));
          }
          const assertion = await navigator.credentials.get({ publicKey });
          if (!assertion) throw new Error('cancelled');
          const credential = {
            challenge,
            credentialId: assertion.id,
            id: assertion.id,
            rawId: encode(assertion.rawId),
            type: assertion.type,
            response: {
              clientDataJSON: encode(assertion.response.clientDataJSON),
              authenticatorData: encode(assertion.response.authenticatorData),
              signature: encode(assertion.response.signature),
              userHandle: assertion.response.userHandle ? encode(assertion.response.userHandle) : null
            }
          };
          const completeResponse = await fetch('{{ path('access.passkey_authentication_complete') }}', {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ credential })
          });
          const result = await completeResponse.json();
          if (!completeResponse.ok || !result.redirect) {
            throw new Error(result.message || result.error || 'Passkey sign-in could not be completed.');
          }
          window.location.assign(result.redirect);
        } catch (error) {
          if (error instanceof DOMException && 'NotAllowedError' === error.name) {
            status.textContent = 'Passkey sign-in was cancelled or timed out.';
          } else {
            status.textContent = error instanceof Error ? error.message : 'Passkey sign-in could not be completed.';
          }
          button.disabled = false;
        }
      });
    })();
  </script>
{% endblock %}
