{% extends '@Accessing/access/base.html.twig' %}

{% set accessPage = 'access-recover_reset.html' %}
{% set accessTitle = 'Reset recovered password' %}
{% set accessSubtitle = 'Use a recovery code to reset the password.' %}

{% block access_body %}
  <div class="interfacing-access-stack">
    <div>

      <h1>Reset recovered password</h1>
      <p class="interfacing-muted">Use a recovery code to reset the password.</p>
    </div>

    {% set recoveryForm = form|default(request_form|default(reset_form|default(null))) %}
    {% if recoveryForm %}
      <div data-access-submit-surface>
        {{ form_start(recoveryForm, {
          attr: {
            class: 'interfacing-form ant-form ant-form-vertical p-fluid',
            'data-interfacing-provider-form': 'access-recover-reset',
            'data-interfacing-provider': 'ant-design-pro',
            'data-interfacing-secondary-provider': 'primereact'
          }
        }) }}

        <div class="interfacing-form-row ant-form-item p-field">
          {{ form_label(recoveryForm.emailAddress, null, {label_attr: {class: 'interfacing-form-label ant-form-item-label'}}) }}
          {{ form_widget(recoveryForm.emailAddress, {attr: {
            class: 'interfacing-form-control ant-input ant-input-lg p-inputtext p-component',
            autocomplete: 'email',
            'data-interfacing-provider-control': 'input',
            'data-interfacing-provider-control-provider': 'antd-pro',
            'data-interfacing-provider-control-secondary-provider': 'primereact'
          }}) }}
          {{ form_errors(recoveryForm.emailAddress) }}
        </div>

        <div class="interfacing-form-row ant-form-item p-field">
          {{ form_label(recoveryForm.code, null, {label_attr: {class: 'interfacing-form-label ant-form-item-label'}}) }}
          {{ form_widget(recoveryForm.code, {attr: {
            class: 'interfacing-form-control ant-input ant-input-lg p-inputtext p-component',
            autocomplete: 'one-time-code',
            inputmode: 'numeric',
            'data-interfacing-provider-control': 'input',
            'data-interfacing-provider-control-provider': 'antd-pro',
            'data-interfacing-provider-control-secondary-provider': 'primereact'
          }}) }}
          {{ form_errors(recoveryForm.code) }}
        </div>

        <div class="interfacing-form-row ant-form-item p-field">
          {{ form_label(recoveryForm.newPassword, null, {label_attr: {class: 'interfacing-form-label ant-form-item-label'}}) }}
          <span class="interfacing-password-control ant-input-affix-wrapper ant-input-affix-wrapper-lg p-password p-component">
            {{ form_widget(recoveryForm.newPassword, {attr: {
              class: 'interfacing-form-control ant-input ant-input-lg p-inputtext p-component',
              autocomplete: 'new-password',
              'data-interfacing-provider-control': 'password',
              'data-interfacing-provider-control-provider': 'antd-pro',
              'data-interfacing-provider-control-secondary-provider': 'primereact'
            }}) }}
            <button type="button" class="interfacing-password-toggle ant-input-password-icon p-password-toggle-mask-icon" data-access-password-toggle aria-label="Show password" aria-pressed="false">
              <svg class="interfacing-password-eye interfacing-password-eye--closed" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3l18 18M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 5.2A10.8 10.8 0 0 1 12 5c5.2 0 9.3 4.4 10.5 6.1a1.5 1.5 0 0 1 0 1.8 14.8 14.8 0 0 1-3 3.2M6.1 6.2A15.7 15.7 0 0 0 1.5 11a1.5 1.5 0 0 0 0 1.8C2.7 14.6 6.8 19 12 19a10.6 10.6 0 0 0 3.1-.5"/></svg><svg class="interfacing-password-eye interfacing-password-eye--open" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M1.5 12s3.8-7 10.5-7 10.5 7 10.5 7-3.8 7-10.5 7S1.5 12 1.5 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </span>
          {{ form_errors(recoveryForm.newPassword) }}
        </div>

        <button class="interfacing-button-primary ant-btn ant-btn-primary ant-btn-lg p-button p-component" type="submit" data-access-submit data-access-submitting-label="Resetting password…">
          <span class="interfacing-submit-spinner" aria-hidden="true"></span>
          <span data-access-submit-label>Reset password</span>
        </button>
        {{ form_end(recoveryForm, {render_rest: false}) }}
      </div>
    {% endif %}

    {% if events is defined and events is iterable %}
      <ul class="interfacing-list">
        {% for event in events %}
          <li>{{ event|json_encode }}</li>
        {% else %}
          <li>No events available.</li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if users is defined and users is iterable %}
      <ul class="interfacing-list">
        {% for item in users %}
          <li>{{ item|json_encode }}</li>
        {% else %}
          <li>No access records available.</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <script>
    (() => {
      document.addEventListener('click', event => {
        const toggle = event.target.closest?.('[data-access-password-toggle]');
        if (!toggle) return;

        const wrapper = toggle.closest('.interfacing-password-control');
        const input = wrapper?.querySelector('input');
        if (!input) return;

        const visible = input.type === 'text';
        input.type = visible ? 'password' : 'text';
        toggle.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
        toggle.setAttribute('aria-pressed', visible ? 'false' : 'true');
        wrapper.classList.toggle('is-password-visible', !visible);
      });
    })();
  </script>
{% endblock %}
