<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
    <php>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="APP_DEBUG" value="1" force="true"/>
        <server name="DATABASE_URL" value="sqlite:///:memory:" force="true"/>
        <server name="MAILER_DSN" value="null://null" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
        <server name="KERNEL_CLASS" value="App\Accessing\Kernel"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <testsuites>
        <testsuite name="Accessing">
            <directory>tests/Unit</directory>
            <directory>tests/Integration</directory>
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="Panther">
            <directory>tests/Panther</directory>
        </testsuite>
    </testsuites>
</phpunit>
